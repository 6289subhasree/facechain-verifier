# Recommended live discovery provider (250 searches/month on the free plan).
SERPAPI_API_KEY=

# Optional fallback provider.
GOOGLE_VISION_API_KEY=

# Search localization.
SEARCH_COUNTRY=in
SEARCH_LANGUAGE=en

# Face verification threshold (cosine similarity).
FACE_MODEL_NAME=buffalo_l
FACE_MATCH_THRESHOLD=0.45

# Candidate download and search limits.
MAX_SEARCH_RESULTS=10
HTTP_TIMEOUT_SECONDS=15

# Leave blank for the zero-cost local EVM. For a public testnet, provide all
# three values and fund the account with testnet ETH only.
EVM_RPC_URL=
EVM_PRIVATE_KEY=
EVM_CHAIN_NAME=Sepolia
EVM_EXPLORER_URL=https://sepolia.etherscan.io/tx
